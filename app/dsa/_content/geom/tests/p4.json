[
  {"name": "An X", "args": "([((0, 0), (4, 4)), ((0, 4), (4, 0))],)", "expect": "'meet'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (4, 4)), ((0, 4), (4, 0))])", "why": "'meet': return (0, 1). The test checks that the two pieces you name really share a point."},
  {"name": "Apart", "args": "([((0, 0), (1, 0)), ((2, 0), (3, 0))],)", "expect": "'none'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (1, 0)), ((2, 0), (3, 0))])", "why": "'none': return None."},
  {"name": "One piece", "args": "([((0, 0), (5, 5))],)", "expect": "'none'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (5, 5))])", "why": "'none'."},
  {"name": "Touching ends", "args": "([((0, 0), (2, 2)), ((2, 2), (4, 0))],)", "expect": "'meet'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (2, 2)), ((2, 2), (4, 0))])", "why": "'meet'. Sharing only an end counts. At the same x, add new pieces before removing finished ones, so both are on the line together."},
  {"name": "Neighbours after a removal", "args": "([((0, 0), (10, 10)), ((0, 5), (2, 5)), ((1, 10), (10, 0))],)", "expect": "'meet'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (10, 10)), ((0, 5), (2, 5)), ((1, 10), (10, 0))])", "why": "'meet': pieces 0 and 2 cross at about (5.3, 5.3). While piece 1 lies between them they are not neighbours; when piece 1 ends at x = 2, they become neighbours. Check the two new neighbours after every removal, not only after an insert."},
  {"name": "An upright piece", "args": "([((0, 3), (4, 3)), ((2, 0), (2, 5))],)", "expect": "'meet'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 3), (4, 3)), ((2, 0), (2, 5))])", "why": "'meet': the upright piece crosses the flat one at (2, 3)."},
  {"name": "Upright pieces on one line", "args": "([((1, 0), (1, 2)), ((1, 3), (1, 5))],)", "expect": "'none'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((1, 0), (1, 2)), ((1, 3), (1, 5))])", "why": "'none'. Same x, but a gap from y = 2 to y = 3."},
  {"name": "Upright pieces that touch", "args": "([((1, 0), (1, 3)), ((1, 3), (1, 5))],)", "expect": "'meet'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((1, 0), (1, 3)), ((1, 3), (1, 5))])", "why": "'meet' at (1, 3)."},
  {"name": "A shared start", "args": "([((0, 0), (5, 1)), ((0, 0), (5, -1))],)", "expect": "'meet'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (5, 1)), ((0, 0), (5, -1))])", "why": "'meet' at (0, 0)."},
  {"name": "Stacked, no crossing", "args": "([((0, 0), (6, 2)), ((1, 3), (7, 5)), ((2, 6), (5, 7)), ((3, 2), (4, 2))],)", "expect": "'none'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (6, 2)), ((1, 3), (7, 5)), ((2, 6), (5, 7)), ((3, 2), (4, 2))])", "why": "'none'. Four pieces that overlap in x; none of them meet."},
  {"name": "Overlapping on one line", "args": "([((0, 0), (4, 2)), ((2, 1), (6, 3)), ((10, 0), (11, 0))],)", "expect": "'meet'", "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "any_crossing([((0, 0), (4, 2)), ((2, 1), (6, 3)), ((10, 0), (11, 0))])", "why": "'meet': pieces 0 and 1 share the piece from (2, 1) to (4, 2)."},
  {"name": "20,000 pieces, none meet", "args": "([(((x >> 40) % 1_000_000, 10 * b), ((x >> 40) % 1_000_000 + 1 + (x >> 8) % 1_000_000, 10 * b + 9)) for k in range(20000) for b in [k * 7919 % 20000] for y in [(k + 10000019) * 6364136223846793005 % 2 ** 64] for x in [(y ^ y >> 29) * 3935559000370003845 % 2 ** 64]],)", "expect": "'none'", "timeout": 4000, "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "20,000 long slanted pieces in separate bands", "why": "'none'. Checking every pair is 200 million pair checks. The sweep keeps the pieces that cross the line in order and checks only neighbours: O(n log n) comparisons (plus list moves)."},
  {"name": "A crossing at the far end", "args": "([(((x >> 40) % 1_000_000, 10 * b), ((x >> 40) % 1_000_000 + 1 + (x >> 8) % 1_000_000, 10 * b + 9)) for k in range(20000) for b in [k * 7919 % 20000] for y in [(k + 20000038) * 6364136223846793005 % 2 ** 64] for x in [(y ^ y >> 29) * 3935559000370003845 % 2 ** 64]] + [((3_000_000, 5), (3_000_010, 15)), ((3_000_000, 15), (3_000_010, 5))],)", "expect": "'meet'", "timeout": 4000, "expr": "crossing_check(args[0], any_crossing(list(args[0])))", "show": "the same 20,000 pieces, then two that cross, far to the right", "why": "'meet': the last two pieces (20000 and 20001). The sweep reaches them only at the end."}
