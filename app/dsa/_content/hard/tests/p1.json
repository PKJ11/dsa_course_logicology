[
  {"name": "One variable", "args": "(1, [[1]])", "expect": "['satisfied', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(1, [[1]], sat)", "why": "['satisfied', True]: the answer [True], with at most 2 calls to sat. Each test reports [is the answer right?, at most n + 1 calls?]."},
  {"name": "It must be False", "args": "(1, [[-1]])", "expect": "['satisfied', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(1, [[-1]], sat)", "why": "['satisfied', True]: [False]. If sat says x1 = True is impossible, x1 must be False."},
  {"name": "No answer", "args": "(1, [[1], [-1]])", "expect": "['no assignment', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(1, [[1], [-1]], sat)", "why": "['no assignment', True]: return None. Ask first whether the whole formula has an answer."},
  {"name": "No clauses", "args": "(3, [])", "expect": "['satisfied', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(3, [], sat)", "why": "['satisfied', True]: anything works, for example [True, True, True]."},
  {"name": "A chain of rules", "args": "(4, [[-1, 2], [-2, 3], [-3, 4], [1]])", "expect": "['satisfied', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(4, [[-1, 2], [-2, 3], [-3, 4], [1]], sat)", "why": "['satisfied', True]: only [True, True, True, True]. Each choice must be kept when asking about the next variable."},
  {"name": "The figure's formula", "args": "(4, [[1, 2], [-1, 3], [-2, -3], [3, 4], [-4, -1]])", "expect": "['satisfied', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(4, [[1, 2], [-1, 3], [-2, -3], [3, 4], [-4, -1]], sat)", "why": "['satisfied', True], for example [True, False, True, False] as in the figure of lesson 1."},
  {"name": "Every clause on three variables", "args": "(3, [[1, 2, 3], [1, 2, -3], [1, -2, 3], [1, -2, -3], [-1, 2, 3], [-1, 2, -3], [-1, -2, 3], [-1, -2, -3]])", "expect": "['no assignment', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(3, [[1, 2, 3], [1, 2, -3], [1, -2, 3], [1, -2, -3], [-1, 2, 3], [-1, 2, -3], [-1, -2, 3], [-1, -2, -3]], sat)", "why": "['no assignment', True]: each of the 8 assignments breaks one clause."},
  {"name": "Choices that depend on each other", "args": "(5, [[1, 2], [-1, -2], [2, 3], [-2, -3], [3, 4], [-3, -4], [4, 5], [-4, -5]])", "expect": "['satisfied', True]", "expr": "oracle_check(find_assignment, *args)", "show": "find_assignment(5, [[1, 2], [-1, -2], [2, 3], [-2, -3], [3, 4], [-3, -4], [4, 5], [-4, -5]], sat)", "why": "['satisfied', True]: the values must alternate. Asking about each variable on its own, without the earlier choices, can mix two different answers."},
